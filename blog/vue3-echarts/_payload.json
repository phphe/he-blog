s include setting fixed height or using flex layout.",{"type":20,"tag":21,"props":1512,"children":1513},{},[1514],{"type":25,"value":1515},"Even after setting height, the issue persisted. Trying Vue's nextTick didn't help. The final solution was wrapping the echarts element with Nuxt's client-only component. I suspect this is Nuxt-specific.",{"type":20,"tag":66,"props":1517,"children":1521},{"className":1518,"code":1519,"language":1520,"meta":7,"style":7},"language-html shiki shiki-themes solarized-light github-dark monokai","\u003Cclient-only>\n  \u003Cdiv ref=\"chartEl\">\u003C/div>\n\u003C/client-only>\n","html",[1522],{"type":20,"tag":28,"props":1523,"children":1524},{"__ignoreMap":7},[1525,1541,1577],{"type":20,"tag":76,"props":1526,"children":1527},{"class":78,"line":79},[1528,1532,1537],{"type":20,"tag":76,"props":1529,"children":1530},{"style":999},[1531],{"type":25,"value":178},{"type":20,"tag":76,"props":1533,"children":1534},{"style":1004},[1535],{"type":25,"value":1536},"client-only",{"type":20,"tag":76,"props":1538,"children":1539},{"style":999},[1540],{"type":25,"value":1012},{"type":20,"tag":76,"props":1542,"children":1543},{"class":78,"line":123},[1544,1548,1552,1556,1560,1564,1569,1573],{"type":20,"tag":76,"props":1545,"children":1546},{"style":999},[1547],{"type":25,"value":1020},{"type":20,"tag":76,"props":1549,"children":1550},{"style":1004},[1551],{"type":25,"value":1025},{"type":20,"tag":76,"props":1553,"children":1554},{"style":1044},[1555],{"type":25,"value":224},{"type":20,"tag":76,"props":1557,"children":1558},{"style":117},[1559],{"type":25,"value":1051},{"type":20,"tag":76,"props":1561,"children":1562},{"style":111},[1563],{"type":25,"value":1056},{"type":20,"tag":76,"props":1565,"children":1566},{"style":999},[1567],{"type":25,"value":1568},">\u003C/",{"type":20,"tag":76,"props":1570,"children":1571},{"style":1004},[1572],{"type":25,"value":1025},{"type":20,"tag":76,"props":1574,"children":1575},{"style":999},[1576],{"type":25,"value":10