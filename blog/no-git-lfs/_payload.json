[{"data":1,"prerenderedAt":82},["ShallowReactive",2],{"content-query-iEOpoSWVnz":3},{"_path":4,"_dir":5,"_draft":6,"_partial":6,"_locale":7,"title":8,"description":7,"date":9,"tags":10,"body":14,"_type":76,"_id":77,"_source":78,"_file":79,"_stem":80,"_extension":81},"/blog/no-git-lfs","blog",false,"","Not Recommended to Use Git LFS for Website Projects","2025-07-14 16:22",[11,12,13],"git","tool","git-lfs",{"type":15,"children":16,"toc":73},"root",[17],{"type":18,"tag":19,"props":20,"children":21},"element","ul",{},[22,29,43,56,68],{"type":18,"tag":23,"props":24,"children":25},"li",{},[26],{"type":27,"value":28},"text","Website projects like React, Next, Vue, Nuxt typically contain some image files (e.g. logos), but usually not too many.",{"type":18,"tag":23,"props":30,"children":31},{},[32,34,41],{"type":27,"value":33},"After using Git LFS, you may find corrupted images when only using ",{"type":18,"tag":35,"props":36,"children":38},"code",{"className":37},[],[39],{"type":27,"value":40},"git clone",{"type":27,"value":42}," to pull the project to server.",{"type":18,"tag":23,"props":44,"children":45},{},[46,48,54],{"type":27,"value":47},"Although you can try commands like ",{"type":18,"tag":35,"props":49,"children":51},{"className":50},[],[52],{"type":27,"value":53},"git lfs pull",{"type":27,"value":55}," to fix, server operations are less convenient than local.",{"type":18,"tag":23,"props":57,"children":58},{},[59,61,66],{"type":27,"value":60},"When deploying my Nuxt website to server, I encountered corrupted images. After using ",{"type":18,"tag":35,"props":62,"children":64},{"className":63},[],[65],{"type":27,"value":53},{"type":27,"value":67},", the PNG files existed on server but showed completely transparent empty images when accessed via URL.",{"type":18,"tag":23,"props":69,"children":70},{},[71],{"type":27,"value":72},"Avoiding Git LFS will save your time and effort.",{"title":7,"searchDepth":74,"depth":74,"links":75},2,[],"markdown","content:blog:979.no-git-lfs.md","content","blog/979.no-git-lfs.md","blog/979.no-git-lfs","md",1760095627951]