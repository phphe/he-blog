[{"data":1,"prerenderedAt":325},["ShallowReactive",2],{"/blog/tag/vscode":3},[4],{"_path":5,"_dir":6,"_draft":7,"_partial":7,"_locale":8,"title":9,"description":10,"date":11,"tags":12,"excerpt":15,"body":25,"_type":319,"_id":320,"_source":321,"_file":322,"_stem":323,"_extension":324},"/blog/vsvode-mouse-lost","blog",false,"","Can't See the Mouse Cursor in VSCode? Here's the Fix!","Recently, I encountered a frustrating issue while using VSCode: the mouse cursor became almost invisible on a light background, especially when switching between the terminal and the editor. This problem was particularly noticeable on Windows systems with AMD graphics cards.","2025-02-04 10:55",[13,14],"vscode","tool",{"type":16,"children":17},"root",[18],{"type":19,"tag":20,"props":21,"children":22},"element","p",{},[23],{"type":24,"value":10},"text",{"type":16,"children":26,"toc":308},[27,31,47,54,70,188,201,262,268,297,302],{"type":19,"tag":20,"props":28,"children":29},{},[30],{"type":24,"value":10},{"type":19,"tag":20,"props":32,"children":33},{},[34,36,45],{"type":24,"value":35},"After some searching, I finally found a solution. By referring to the ",{"type":19,"tag":37,"props":38,"children":42},"a",{"href":39,"rel":40},"https://github.com/microsoft/vscode/issues/204181",[41],"nofollow",[43],{"type":24,"value":44},"VSCode GitHub Issue",{"type":24,"value":46},", I discovered that this issue is caused by the Chromium-based rendering mechanism of VSCode. In certain cases, the hardware acceleration or direct composition rendering of VSCode can cause the mouse cursor color to behave abnormally, especially on light backgrounds.",{"type":19,"tag":48,"props":49,"children":51},"h2",{"id":50},"solution",[52],{"type":24,"value":53},"Solution",{"type":19,"tag":55,"props":56,"children":58},"h3",{"id":57},"method-1-disable-hardware-acceleration-disable-hardware-acceleration",[59,61,68],{"type":24,"value":60},"Method 1: Disable Hardware Acceleration (",{"type":19,"tag":62,"props":63,"children":65},"code",{"className":64},[],[66],{"type":24,"value":67},"disable-hardware-acceleration",{"type":24,"value":69},")",{"type":19,"tag":71,"props":72,"children":73},"ol",{},[74,163],{"type":19,"tag":75,"props":76,"children":77},"li",{},[78,84,86],{"type":19,"tag":79,"props":80,"children":81},"strong",{},[82],{"type":24,"value":83},"Via Settings File",{"type":24,"value":85},":",{"type":19,"tag":87,"props":88,"children":89},"ul",{},[90,111,158],{"type":19,"tag":75,"props":91,"children":92},{},[93,95,101,103,109],{"type":24,"value":94},"Open VSCode and press ",{"type":19,"tag":62,"props":96,"children":98},{"className":97},[],[99],{"type":24,"value":100},"Ctrl + Shift + P",{"type":24,"value":102},", then type ",{"type":19,"tag":62,"props":104,"children":106},{"className":105},[],[107],{"type":24,"value":108},"Preferences: Configure Runtime Arguments",{"type":24,"value":110}," and select it.",{"type":19,"tag":75,"props":112,"children":113},{},[114,116,122,124],{"type":24,"value":115},"In the opened ",{"type":19,"tag":62,"props":117,"children":119},{"className":118},[],[120],{"type":24,"value":121},"argv.json",{"type":24,"value":123}," file, add the following configuration:\n",{"type":19,"tag":125,"props":126,"children":130},"pre",{"code":127,"language":128,"meta":8,"className":129,"style":8},"\"disable-hardware-acceleration\": true\n","json","language-json shiki shiki-themes solarized-light github-dark monokai",[131],{"type":19,"tag":62,"props":132,"children":133},{"__ignoreMap":8},[134],{"type":19,"tag":135,"props":136,"children":139},"span",{"class":137,"line":138},"line",1,[140,146,152],{"type":19,"tag":135,"props":141,"children":143},{"style":142},"--shiki-default:#2AA198;--shiki-dark:#9ECBFF;--shiki-sepia:#E6DB74",[144],{"type":24,"value":145},"\"disable-hardware-acceleration\"",{"type":19,"tag":135,"props":147,"children":149},{"style":148},"--shiki-default:#657B83;--shiki-dark:#E1E4E8;--shiki-sepia:#F8F8F2",[150],{"type":24,"value":151},": ",{"type":19,"tag":135,"props":153,"children":155},{"style":154},"--shiki-default:#B58900;--shiki-dark:#79B8FF;--shiki-sepia:#AE81FF",[156],{"type":24,"value":157},"true\n",{"type":19,"tag":75,"props":159,"children":160},{},[161],{"type":24,"value":162},"Save the file and restart VSCode.",{"type":19,"tag":75,"props":164,"children":165},{},[166,171,172],{"type":19,"tag":79,"props":167,"children":168},{},[169],{"type":24,"value":170},"Via Command Line",{"type":24,"value":85},{"type":19,"tag":87,"props":173,"children":174},{},[175],{"type":19,"tag":75,"props":176,"children":177},{},[178,180],{"type":24,"value":179},"When launching VSCode from the command line, add the following parameter:\n",{"type":19,"tag":125,"props":181,"children":183},{"code":182},"code --disable-hardware-acceleration\n",[184],{"type":19,"tag":62,"props":185,"children":186},{"__ignoreMap":8},[187],{"type":24,"value":182},{"type":19,"tag":55,"props":189,"children":191},{"id":190},"method-2-disable-direct-composition-disable-direct-composition",[192,194,200],{"type":24,"value":193},"Method 2: Disable Direct Composition (",{"type":19,"tag":62,"props":195,"children":197},{"className":196},[],[198],{"type":24,"value":199},"disable-direct-composition",{"type":24,"value":69},{"type":19,"tag":71,"props":202,"children":203},{},[204,239],{"type":19,"tag":75,"props":205,"children":206},{},[207,212,213],{"type":19,"tag":79,"props":208,"children":209},{},[210],{"type":24,"value":211},"Via Shortcut",{"type":24,"value":85},{"type":19,"tag":87,"props":214,"children":215},{},[216,221,234],{"type":19,"tag":75,"props":217,"children":218},{},[219],{"type":24,"value":220},"Find the VSCode shortcut, right-click it, and select \"Properties.\"",{"type":19,"tag":75,"props":222,"children":223},{},[224,226],{"type":24,"value":225},"Add the following parameter at the end of the \"Target\" field:\n",{"type":19,"tag":125,"props":227,"children":229},{"code":228},"--disable-direct-composition\n",[230],{"type":19,"tag":62,"props":231,"children":232},{"__ignore