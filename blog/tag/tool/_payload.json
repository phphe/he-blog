[{"data":1,"prerenderedAt":1534},["ShallowReactive",2],{"/blog/tag/tool":3},[4,83,390,460,696,1025],{"_path":5,"_dir":6,"_draft":7,"_partial":7,"_locale":8,"title":9,"description":8,"date":10,"tags":11,"body":15,"_type":77,"_id":78,"_source":79,"_file":80,"_stem":81,"_extension":82},"/blog/no-git-lfs","blog",false,"","Not Recommended to Use Git LFS for Website Projects","2025-07-14 16:22",[12,13,14],"git","tool","git-lfs",{"type":16,"children":17,"toc":74},"root",[18],{"type":19,"tag":20,"props":21,"children":22},"element","ul",{},[23,30,44,57,69],{"type":19,"tag":24,"props":25,"children":26},"li",{},[27],{"type":28,"value":29},"text","Website projects like React, Next, Vue, Nuxt typically contain some image files (e.g. logos), but usually not too many.",{"type":19,"tag":24,"props":31,"children":32},{},[33,35,42],{"type":28,"value":34},"After using Git LFS, you may find corrupted images when only using ",{"type":19,"tag":36,"props":37,"children":39},"code",{"className":38},[],[40],{"type":28,"value":41},"git clone",{"type":28,"value":43}," to pull the project to server.",{"type":19,"tag":24,"props":45,"children":46},{},[47,49,55],{"type":28,"value":48},"Although you can try commands like ",{"type":19,"tag":36,"props":50,"children":52},{"className":51},[],[53],{"type":28,"value":54},"git lfs pull",{"type":28,"value":56}," to fix, server operations are less convenient than local.",{"type":19,"tag":24,"props":58,"children":59},{},[60,62,67],{"type":28,"value":61},"When deploying my Nuxt website to server, I encountered corrupted images. After using ",{"type":19,"tag":36,"props":63,"children":65},{"className":64},[],[66],{"type":28,"value":54},{"type":28,"value":68},", the PNG files existed on server but showed completely transparent empty images when accessed via URL.",{"type":19,"tag":24,"props":70,"children":71},{},[72],{"type":28,"value":73},"Avoiding Git LFS will save your time and effort.",{"title":8,"searchDepth":75,"depth":75,"links":76},2,[],"markdown","content