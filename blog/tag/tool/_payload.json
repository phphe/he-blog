":301},{"__ignoreMap":8},[302],{"type":28,"value":297},{"type":19,"tag":24,"props":304,"children":305},{},[306],{"type":28,"value":307},"Save and use this shortcut to launch VSCode.",{"type":19,"tag":24,"props":309,"children":310},{},[311,315,316],{"type":19,"tag":149,"props":312,"children":313},{},[314],{"type":28,"value":239},{"type":28,"value":155},{"type":19,"tag":20,"props":317,"children":318},{},[319],{"type":19,"tag":24,"props":320,"children":321},{},[322,323],{"type":28,"value":248},{"type":19,"tag":194,"props":324,"children":326},{"code":325},"code --disable-direct-composition\n",[327],{"type":19,"tag":36,"props":328,"children":329},{"__ignoreMap":8},[330],{"type":28,"value":325},{"type":19,"tag":120,"props":332,"children":334},{"id":333},"notes",[335],{"type":28,"value":336},"Notes",{"type":19,"tag":20,"props":338,"children":339},{},[340,345],{"type":19,"tag":24,"props":341,"children":342},{},[343],{"type":28,"value":344},"Disabling hardware acceleration may affect the performance of VSCode, especially when working with large projects.",{"type":19,"tag":24,"props":346,"children":347},{},[348,350,356,358,364],{"type":28,"value":349},"If the issue persists, try using both ",{"type":19,"tag":36,"props":351,"children":353},{"className":352},[],[354],{"type":28,"value":355},"--disable-hardware-acceleration",{"type":28,"value":357}," and ",{"type":19,"tag":36,"props":359,"children":361},{"className":360},[],[362],{"type":28,"value":363},"--disable-direct-composition",{"type":28,"value":365}," parameters simultaneously.",{"type":19,"tag":93,"props":367,"children":368},{},[369],{"type":28,"value":370},"By following these methods, I successfully resolved the issue of the mouse cursor being hard to see in VSCode. I hope this article helps you if you encounter the same problem!\nYou can copy and paste this Markdown code directly into your Markdown editor.",{"type":19,"tag":372,"props":373,"children":374},"style",{},[375],{"type":28,"value":376},"html .default .shiki 