value":747},", the home page should automatically register the route ",{"type":19,"tag":36,"props":749,"children":751},{"className":750},[],[752],{"type":28,"value":753},"/en",{"type":28,"value":755},". After configuring according to the official documentation, everything else was working fine except for the routes. By the way, Nuxt comes with a built-in in-browser development tool that allows you to view the registered routes. You can click on the floating Nuxt icon on the page or press the ",{"type":19,"tag":36,"props":757,"children":759},{"className":758},[],[760],{"type":28,"value":761},"Shift+Alt+D",{"type":28,"value":763}," key combination to open it.",{"type":19,"tag":93,"props":765,"children":766},{},[767,769,775],{"type":28,"value":768},"After a few hours of tinkering, I finally succeeded. As for why I had to do it this way, I have no idea. Here's how I wrote it in ",{"type":19,"tag":36,"props":770,"children":772},{"className":771},[],[773],{"type":28,"value":774},"nuxt.config.ts/js",{"type":28,"value":155},{"type":19,"tag":194,"props":777,"children":779},{"className":484,"code":778,"language":486,"meta":8,"style":8},"i18n: {\n  locales: [\"en\", \"zh\"], // used in URL path prefix\n  defaultLocale: \"en\", // default locale of your project for Nuxt pages and routings\n}\n",[780],{"type":19,"tag":36,"props":781,"children":782},{"__ignoreMap":8},[783,795,827,851],{"type":19,"tag":204,"props":784,"children":785},{"class":206,"line":207},[786,791],{"type":19,"tag":204,"props":787,"children":788},{"style":504},[789],{"type":28,"value":790},"i18n",{"type":19,"tag":204,"props":792,"children":793},{"style":217},[794],{"type":28,"value":512},{"type":19,"tag":204,"props":796,"children":797},{"class":206,"line":75},[798,803,807,811,815,819,823],{"type":19,"tag":204,"props":799,"children":800},{"style":504},[801],{"type":28,"value":802},"  locales",{"type":19,"tag":204,"props":804,"children":805},{"style":217},[806],{"type":28,"value":548},{"type":19,"tag":204,"props"