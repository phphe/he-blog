 On Windows.\n",{"type":20,"tag":126,"props":189,"children":191},{"class":128,"line":190},5,[192,197,202],{"type":20,"tag":126,"props":193,"children":194},{"style":142},[195],{"type":25,"value":196},"powershell",{"type":20,"tag":126,"props":198,"children":199},{"style":148},[200],{"type":25,"value":201}," -c",{"type":20,"tag":126,"props":203,"children":204},{"style":154},[205],{"type":25,"value":206}," \"irm https://astral.sh/uv/install.ps1 | iex\"\n",{"type":20,"tag":126,"props":208,"children":210},{"class":128,"line":209},6,[211],{"type":20,"tag":126,"props":212,"children":213},{"emptyLinePlaceholder":175},[214],{"type":25,"value":178},{"type":20,"tag":126,"props":216,"children":218},{"class":128,"line":217},7,[219],{"type":20,"tag":126,"props":220,"children":221},{"style":133},[222],{"type":25,"value":223},"# With pip.\n",{"type":20,"tag":126,"props":225,"children":227},{"class":128,"line":226},8,[228,233,238],{"type":20,"tag":126,"props":229,"children":230},{"style":142},[231],{"type":25,"value":232},"pip",{"type":20,"tag":126,"props":234,"children":235},{"style":154},[236],{"type":25,"value":237}," install",{"type":20,"tag":126,"props":239,"children":240},{"style":154},[241],{"type":25,"value":242}," uv\n",{"type":20,"tag":21,"props":244,"children":245},{},[246,248,254],{"type":25,"value":247},"After installation, you can check if UV is successfully installed by running ",{"type":20,"tag":122,"props":249,"children":251},{"className":250},[],[252],{"type":25,"value":253},"uv --version",{"type":25,"value":255},".",{"type":20,"tag":65,"props":257,"children":259},{"id":258},"python-version",[260],{"type":25,"value":261},"Python Version",{"type":20,"tag":21,"props":263,"children":264},{},[265,267,273],{"type":25,"value":266},"After downloading the 2GB Torch, I found that one of the project dependencies required a Python version between 3.7 and 3.11, while my Python version was 3.13. I recommend using ",{"type":20,"tag":122,"props":268,"children":270},{"className":269},[],[271],{"type":25,"value":272},"python3.10",{"type":25,"value":274},", which should be sufficient for most cases.",{"type":20,"tag":65,"props":276,"children":278},{"id":277},"virtual-environment",[279],{"type":25,"value":280},"Virtual Environment",{"type":20,"tag":21,"props":282,"children":283},{},[284,286,292],{"type":25,"value":285},"Create a virtual environment in your project folder by running ",{"type":20,"tag":122,"props":287,"children":289},{"className":288},[],[290],{"type":25,"value":291},"uv venv --python 3.10",{"type":25,"value":255},{"type":20,"tag":65,"props":294,"children":296},{"id":295},"installing-dependencies",[297],{"type":25,"value":298},"Installing Dependencies",{"type":20,"tag":21,"props":300,"children":301},{},[302,304,310,312,318,320,326,328,334,336,342],{"type":25,"value":303},"To install general dependencies (excluding ",{"type":20,"tag":122,"props":305,"children":307},{"className":306},[],[308],{"type":25,"value":309},"torch",{"type":25,"value":311},"), run ",{"type":20,"tag":122,"props":313,"children":315},{"className":314},[],[316],{"type":25,"value":317},"uv pip install xxx1 xxx2 xxx3",{"type":25,"value":319},". There is no need to activate the virtual environment. However, you need to activate the virtual environment when running the code. If you want to use a mirror to speed up the process, for example, using Tsinghua's mirror, change it to ",{"type":20,"tag":122,"props":321,"children":323},{"className":322},[],[324],{"type":25,"value":325},"uv pip install xxx1 xxx2 xxx3 -i https://pypi.tuna.tsinghua.edu.cn/simple",{"type":25,"value":327},". To install all dependencies from ",{"type":20,"tag":122,"props":329,"children":331},{"className":330},[],[332],{"type":25,"value":333},"requirements.txt",{"type":25,"value":335},", run ",{"type":20,"tag":122,"props":337,"children":339},{"className":338},[],[340],{"type":25,"value":341},"uv pip install -r requirements.txt",{"type":25,"value":255},{"type":20,"tag":65,"props":344,"children":346},{"id":345},"installing-torch",[347],{"type":25,"value":348},"Installing Torch",{"type":20,"tag":21,"props":350,"children":351},{},[352,354,361,363,369],{"type":25,"value":353},"First, visit this link: ",{"type":20,"tag":88,"props":355,"children":358},{"href":356,"rel":357},"https://pytorch.org/get-started/locally/",[92],[359],{"type":25,"value":360},"Start Locally",{"type":25,"value":362},". Select your environment, and it will generate the installation code. Although my CUDA version is 12.8, it was not available, so I chose the highest available version, 12.6. The code provided to me was ",{"type":20,"tag":122,"props":364,"children":366},{"className":365},[],[367],{"type":25,"value":368},"pip3 install torch torchvision torchaudio --index-url https://download.pytorch.org/whl/cu126",{"type":25,"value":255},{"type":20,"tag":21,"props":371,"children":372},{},[373,375,381,383,389],{"type":25,"value":374},"I split it into two parts: ",{"type":20,"tag":122,"props":376,"children":378},{"className":377},[],[379],{"type":25,"value":380},"uv pip install torchvision torchaudio --index-url https://download.pytorch.org/whl/cu126",{"type":25,"value":382},". This should not be a problem since these packages are relatively small. The key part is this: ",{"type":20,"tag":122,"props":384,"children":386},{"className":385},[],[387],{"type":25,"value":388},"uv pip install torch --index-url https://download.pytorch.org/whl/cu126",{"type":25,"value":390},". The Torch package is over 2GB. You can try this code to see your download speed. If the speed is not satisfactory, use the following method.",{"type":20,"tag":21,"props":392,"children":393},{},[394,396,401],{"type":25,"value":395},"There are some methods online to install ",{"type":20,"tag":122,"props":397,"children":399},{"className":398},[],[400],{"type":25,"value":309},{"type":25,"value":402}," using a mirror. If you choose a newer CUDA or Torch version, you may find that the mirror is ineffective.",{"type":20,"tag":21,"props":404,"children":405},{},[406,412,414,420],{"type":20,"tag":122,"props":407,"children":409},{"className":408},[],[410],{"type":25,"value":411},"pip install",{"type":25,"value":413}," can install from a ",{"type":20,"tag":122,"props":415,"children":417},{"className":416},[],[418],{"type":25,"value":419},"whl",{"type":25,"value":421}," file. Therefore, find the address of the file you need, download it using other download tools, and then install it. This is much faster. Moreover, when the CUDA and Python versions are the same, multiple virtual environments can use this downloaded file for installation.",{"type":20,"tag":21,"props":423,"children":424},{},[425,427,432,434,440,442,448,450,456,458,464,466,472,474,480,482,488,490,496,498,504],{"type":25,"value":426},"Open the URL in the code generated by ",{"type":20,"tag":88,"props":428,"children":430},{"href":356,"rel":429},[92],[431],{"type":25,"value":360},{"type":25,"value":433}," (",{"type":20,"tag":122,"props":435,"children":437},{"className":436},[],[438],{"type":25,"value":439},"--index-url",{"type":25,"value":441},"). Mine was ",{"type":20,"tag":122,"props":443,"children":445},{"className":444},[],[446],{"type":25,"value":447},"https://download.pytorch.org/whl/cu126",{"type":25,"value":449},". Find Torch and click to open it. There are many files. If you don't know which one to choose, understand the naming convention of these files. I chose ",{"type":20,"tag":122,"props":451,"children":453},{"className":452},[],[454],{"type":25,"value":455},"torch-2.6.0+cu126-cp310-cp310-win_amd64.whl",{"type":25,"value":457},". Here, ",{"type":20,"tag":122,"props":459,"children":461},{"className":460},[],[462],{"type":25,"value":463},"2.6.0",{"type":25,"value":465}," is the Torch version, ",{"type":20,"tag":122,"props":467,"children":469},{"className":468},[],[470],{"type":25,"value":471},"cu126",{"type":25,"value":473}," is the CUDA version (",{"type":20,"tag":122,"props":475,"children":477},{"className":476},[],[478],{"type":25,"value":479},"cuda 12.6",{"type":25,"value":481},"), ",{"type":20,"tag":122,"props":483,"children":485},{"className":484},[],[486],{"type":25,"value":487},"cp310",{"type":25,"value":489}," is the Python version (",{"type":20,"tag":122,"props":491,"children":493},{"className":492},[],[494],{"type":25,"value":495},"python 3.10",{"type":25,"value":497},"), and ",{"type":20,"tag":122,"props":499,"children":501},{"className":500},[],[502],{"type":25,"value":503},"win_amd64",{"type":25,"value":505}," is the operating system.",{"type":20,"tag":21,"props":507,"children":508},{},[509,511,517],{"type":25,"value":510},"Save the downloaded file outside the project. In the project folder, run ",{"type":20,"tag":122,"props":512,"children":514},{"className":513},[],[515],{"type":25,"value":516},"uv pip install torch file path",{"type":25,"value":518}," to install Torch.",{"type":20,"tag":65,"props":520,"children":522},{"id":521},"testing-whether-cuda-and-torch-are-working",[523],{"type":25,"value":524},"Testing Whether CUDA and Torch Are Working",{"type":20,"tag":21,"props":526,"children":527},{},[528,530,536],{"type":25,"value":529},"Create a ",{"type":20,"tag":122,"props":531,"children":533},{"className":532},[],[534],{"type":25,"value":535},"check_cuda_torch.py",{"type":25,"value":537}," file.",{"type":20,"tag":115,"props":539,"children":542},{"className":540,"code":541,"language":14,"meta":8,"style":8},"language-python shiki shiki-themes solarized-light github-dark monokai","import torch\n\ndef test_pytorch_and_cuda():\n    print(\"PyTorch Version:\", torch.__version__)\n\n    # Check if CUDA is available\n    if torch.cuda.is_available():\n        print(\"Is CUDA Available: Yes\")\n        print(\"CUDA Version:\", torch.version.cuda)\n        print(\"Number of CUDA Devices Supported:\", torch.cuda.device_count())\n\n        # Get the name of the current device\n        current_device = torch.cuda.current_device()\n        print(\"Current CUDA Device Name:\", torch.cuda.get_device_name(current_device))\n\n        # Test tensor operations on the GPU\n        # Create a tensor and move it to the GPU\n        x = torch.tensor([1.0, 2.0, 3.0], device=\"cuda\")\n        y = torch.tensor([4.0, 5.0, 6.0], device=\"cuda\")\n        z = x + y\n        print(\"Result of Calculation on GPU:\", z)\n    else:\n        print(\"Is CUDA Available: No\")\n\nif __name__ == \"__main__\":\n    test_pytorch_and_cuda()\n",[543],{"type":20,"tag":122,"props":544,"children":545},{"__ignoreMap":8},[546,560,567,586,621,628,636,649,670,692,714,722,731,750,772,780,789,798,865,925,953,975,989,1010,1018,1046],{"type":20,"tag":126,"props":547,"children":548},{"class":128,"line":129},[549,554],{"type":20,"tag":126,"props":550,"children":551},{"style":160},[552],{"type":25,"value":553},"import",{"type":20,"tag":126,"props":555,"children":557},{"style":556},"--shiki-default:#657B83;--shiki-dark:#E1E4E8;--shiki-sepia:#F8F8F2",[558],{"type":25,"value":559}," torch\n",{"type":20,"tag":126,"props":561,"children":562},{"class":128,"line":38},[563],{"type":20,"tag":126,"props":564,"children":565},{"emptyLinePlaceholder":175},[566],{"type":25,"value":178},{"type":20,"tag":126,"props":568,"children":569},{"class":128,"line":171},[570,576,581],{"type":20,"tag":126,"props":571,"children":573},{"style":572},"--shiki-default:#586E75;--shiki-default-font-weight:bold;--shiki-default-font-style:inherit;--shiki-dark:#F97583;--shiki-dark-font-weight:inherit;--shiki-dark-font-style:inherit;--shiki-sepia:#66D9EF;--shiki-sepia-font-weight:inherit;--shiki-sepia-font-style:italic",[574],{"type":25,"value":575},"def",{"type":20,"tag":126,"props":577,"children":578},{"style":142},[579],{"type":25,"value":580}," test_pytorch_and_cuda",{"type":20,"tag":126,"props":582,"children":583},{"style":556},[584],{"type":25,"value":585},"():\n",{"type":20,"tag":126,"props":587,"children":588},{"class":128,"line":181},[589,595,600,605,610,616],{"type":20,"tag":126,"props":590,"children":592},{"style":591},"--s