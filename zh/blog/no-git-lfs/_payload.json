[{"data":1,"prerenderedAt":58},["ShallowReactive",2],{"content-query-OZMuelm21x":3},{"_path":4,"_dir":5,"_draft":6,"_partial":6,"_locale":7,"title":8,"description":7,"date":9,"tags":10,"body":14,"_type":52,"_id":53,"_source":54,"_file":55,"_stem":56,"_extension":57},"/zh/blog/no-git-lfs","blog",false,"","不推荐对网站项目使用git lfs","2025-07-14 16:22",[11,12,13],"git","tool","git-lfs",{"type":15,"children":16,"toc":49},"root",[17],{"type":18,"tag":19,"props":20,"children":21},"element","ul",{},[22,29,34,39,44],{"type":18,"tag":23,"props":24,"children":25},"li",{},[26],{"type":27,"value":28},"text","网站项目如react, next, vue, nuxt, 一般会包含一些图片文件, 如logo, 但是不会太多.",{"type":18,"tag":23,"props":30,"children":31},{},[32],{"type":27,"value":33},"使用git lfs后, 只使用git clone拉取项目到服务器, 可能会发现图片损坏.",{"type":18,"tag":23,"props":35,"children":36},{},[37],{"type":27,"value":38},"当然你可以尝试使用git lfs pull等命令修复, 但是在服务器上操作不如本地方便.",{"type":18,"tag":23,"props":40,"children":41},{},[42],{"type":27,"value":43},"我把nuxt网站项目部署到服务器, 发现图片损坏. 使用git lfs pull后, 发现访问图片已经在服务器上存在, 但通过url访问时png图片时, 获得的是一张一样宽高但完全透明的没有内容的图片.",{"type":18,"tag":23,"props":45,"children":46},{},[47],{"type":27,"value":48},"不使用git lfs可以节约你的生命.",{"title":7,"searchDepth":50,"depth":50,"links":51},2,[],"markdown","content:zh:blog:979.no-git-lfs.md","content","zh/blog/979.no-git-lfs.md","zh/blog/979.no-git-lfs","md",1760095628797]