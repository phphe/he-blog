90},{},[91,93,98],{"type":24,"value":92},"chrome.runtime.sendMessage, 向其他组件或后台脚本发送消息, ",{"type":18,"tag":80,"props":94,"children":96},{"className":95},[],[97],{"type":24,"value":85},{"type":24,"value":99},"不能收到它发出的消息.",{"type":18,"tag":36,"props":101,"children":102},{},[103],{"type":24,"value":104},"接收消息只需要使用一个方法: chrome.runtime.onMessage.",{"title":8,"searchDepth":106,"depth":106,"links":107},2,[108,109],{"id":21,"depth":106,"text":21},{"id":63,"depth":106,"text":63},"markdown","content:zh:blog:990.faq-chrome-ext.md","content","zh/blog/990.faq-chrome-ext.md","zh/blog/990.faq-chrome-ext","md",1760095631120]